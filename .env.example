# PostgreSQL connection string. Use a pooled connection URL from your provider
# when available (for example, Neon pooled connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Only needed when running `npm run db:seed` to create the first administrator.
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_FULL_NAME="System Administrator"
