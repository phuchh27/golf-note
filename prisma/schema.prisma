// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  fullName     String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  roleAssignments  UserRoleAssignment[]
  permissionGrants UserPermissionAssignment[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAssignments UserRoleAssignment[]
  permissions     RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  module      String

  createdAt DateTime @default(now())

  roles           RolePermission[]
  userAssignments UserPermissionAssignment[]
}

model UserRoleAssignment {
  id     String @id @default(uuid())
  userId String
  roleId String

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([expiresAt])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermissionAssignment {
  id           String @id @default(uuid())
  userId       String
  permissionId String

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([expiresAt])
}

// =========================================================
// INVENTORY
// =========================================================

enum ItemStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE_OUT
  DISPOSAL_OUT
  LOAN_OUT
  LOAN_RETURN
  RETURN_IN
  RETURN_OUT
  OPENING
}

enum StockLoanStatus {
  BORROWED
  RETURNED
}

enum ArchiveEntryType {
  TEXT
  LINK
  IMAGE
}

enum SaleCustomerType {
  ROOM
  EXTERNAL
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum StockReceiptStatus {
  COMPLETED
  CANCELLED
}

enum HandoverTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum HandoverTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InventoryGroup {
  BEVERAGE
  SUPPLIES
}

model ShiftSchedule {
  code        String   @id
  labelVi     String
  labelEn     String
  startMinute Int
  endMinute   Int
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Category {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([isActive])
  @@index([name])
}

model Item {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  unit String

  status ItemStatus @default(ACTIVE)

  // Giá nhập gần nhất / giá vốn tham khảo
  costPrice Decimal @db.Decimal(12, 2)

  // Giá bán hiện tại
  sellingPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockBalance   StockBalance?
  stockLots      StockLot[]
  stockMovements StockMovement[]
  stockLoans     StockLoan[]
  receiptItems   StockReceiptItem[]
  saleItems      SaleItem[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model StockBalance {
  id String @id @default(uuid())

  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  quantity Decimal @default(0) @db.Decimal(12, 3)

  updatedAt DateTime @updatedAt
}

model StockLot {
  id String @id @default(uuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Mã lô do nhà cung cấp cung cấp, nếu có
  batchCode String?

  receivedAt DateTime  @default(now())
  producedAt DateTime?
  expiresAt  DateTime?

  quantity Decimal  @default(0) @db.Decimal(12, 3)
  unitCost Decimal? @db.Decimal(12, 2)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  stockLoans     StockLoan[]
  receiptItem    StockReceiptItem?
  saleItems      SaleItem[]

  @@index([itemId])
  @@index([receivedAt])
  @@index([expiresAt])
  @@index([batchCode])
}

model StockReceipt {
  id            String             @id @default(uuid())
  receiptNumber String?            @unique
  batchCode     String?
  supplierName  String?
  receivedAt    DateTime           @default(now())
  note          String?
  status        StockReceiptStatus @default(COMPLETED)
  createdBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items StockReceiptItem[]

  @@index([receivedAt])
  @@index([status])
  @@index([batchCode])
}

model StockReceiptItem {
  id         String    @id @default(uuid())
  receiptId  String
  itemId     String
  lotId      String?   @unique
  quantity   Decimal   @db.Decimal(12, 3)
  unitCost   Decimal?  @db.Decimal(12, 2)
  batchCode  String?
  producedAt DateTime?
  expiresAt  DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  receipt   StockReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item      Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot       StockLot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@index([receiptId])
  @@index([itemId])
  @@index([expiresAt])
}

model StockMovement {
  id String @id @default(uuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  lotId String?
  lot   StockLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  saleItemId String?
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  receiptItemId String?
  receiptItem   StockReceiptItem? @relation(fields: [receiptItemId], references: [id], onDelete: SetNull)

  type StockMovementType

  // Số lượng thay đổi
  quantity Decimal @db.Decimal(12, 3)

  // Tồn kho trước movement
  balanceBefore Decimal @db.Decimal(12, 3)

  // Tồn kho sau movement
  balanceAfter Decimal @db.Decimal(12, 3)

  // Giá tại thời điểm movement
  unitCost Decimal? @db.Decimal(12, 2)

  // Ghi chú
  note String?

  // Người thực hiện
  createdBy String?

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@index([createdBy])
  @@index([itemId, createdAt])
  @@index([lotId])
  @@index([saleItemId])
  @@index([receiptItemId])
}

model StockLoan {
  id         String          @id @default(uuid())
  itemId     String
  lotId      String?
  quantity   Decimal         @db.Decimal(12, 3)
  borrower   String
  note       String?
  status     StockLoanStatus @default(BORROWED)
  borrowedBy String?
  borrowedAt DateTime        @default(now())
  returnedAt DateTime?
  returnNote String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  item Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot  StockLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([itemId, status])
  @@index([lotId])
  @@index([borrowedAt])
  @@index([borrowedBy])
}

model Sale {
  id String @id @default(uuid())

  customerType SaleCustomerType
  roomNumber   String?
  customerName String?
  note         String?

  totalAmount Decimal    @db.Decimal(12, 2)
  soldAt      DateTime   @default(now())
  status      SaleStatus @default(COMPLETED)
  createdBy   String?
  createdAt   DateTime   @default(now())

  items SaleItem[]

  @@index([soldAt])
  @@index([customerType])
  @@index([roomNumber])
  @@index([status])
}

model SaleItem {
  id String @id @default(uuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  lotId String?
  lot   StockLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  movements StockMovement[]

  @@index([saleId])
  @@index([itemId])
  @@index([lotId])
}

model HandoverTask {
  id          String               @id @default(uuid())
  title       String
  description String?
  area        String?
  createdBy   String
  assigneeId  String?
  status      HandoverTaskStatus   @default(OPEN)
  priority    HandoverTaskPriority @default(NORMAL)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  updates HandoverTaskUpdate[]

  @@index([status, priority])
  @@index([dueAt])
  @@index([createdBy])
  @@index([assigneeId])
}

model HandoverTaskUpdate {
  id        String             @id @default(uuid())
  taskId    String
  actorId   String
  status    HandoverTaskStatus
  note      String?
  createdAt DateTime           @default(now())

  task HandoverTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId])
}

model ArchiveEntry {
  id        String           @id @default(uuid())
  title     String
  type      ArchiveEntryType
  content   String           @db.Text
  createdBy String?
  updatedBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type, updatedAt])
  @@index([title])
}

model InventoryReport {
  id         String   @id @default(uuid())
  reportDate DateTime @db.Date
  shiftCode  String
  shiftLabel String
  startsAt   DateTime
  endsAt     DateTime
  createdBy  String
  createdAt  DateTime @default(now())
  note       String?

  inventoryItems InventoryReportItem[]
  sales          InventoryReportSale[]

  @@unique([reportDate, shiftCode])
  @@index([reportDate])
  @@index([createdBy, createdAt])
}

model InventoryReportItem {
  id               String         @id @default(uuid())
  reportId         String
  itemId           String
  sku              String
  name             String
  categoryCode     String
  categoryName     String
  inventoryGroup   InventoryGroup
  unit             String
  quantity         Decimal        @db.Decimal(12, 3)
  previousQuantity Decimal?       @db.Decimal(12, 3)
  change           Decimal?       @db.Decimal(12, 3)
  soldQuantity     Decimal        @default(0) @db.Decimal(12, 3)
  receivedQuantity Decimal        @default(0) @db.Decimal(12, 3)
  adjustedIn       Decimal        @default(0) @db.Decimal(12, 3)
  adjustedOut      Decimal        @default(0) @db.Decimal(12, 3)

  report InventoryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, itemId])
  @@index([reportId, inventoryGroup])
}

model InventoryReportSale {
  id           String           @id @default(uuid())
  reportId     String
  saleId       String
  customerType SaleCustomerType
  roomNumber   String?
  customerName String?
  sellerName   String?
  soldAt       DateTime
  totalAmount  Decimal          @db.Decimal(12, 2)

  report InventoryReport           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  items  InventoryReportSaleItem[]

  @@unique([reportId, saleId])
  @@index([reportId, soldAt])
}

model InventoryReportSaleItem {
  id           String  @id @default(uuid())
  reportSaleId String
  itemId       String
  sku          String
  itemName     String
  unit         String
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  totalPrice   Decimal @db.Decimal(12, 2)

  reportSale InventoryReportSale @relation(fields: [reportSaleId], references: [id], onDelete: Cascade)

  @@index([reportSaleId])
  @@index([itemId])
}
